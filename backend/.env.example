# CSBuddy backend environment variables

# Comma-separated list of frontend origins allowed by CORS.
# For local development with Vite:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For production (replace with your Vercel URL):
# CORS_ORIGINS=https://csbuddy-your-team.vercel.app

# Optional admin token for the /api/admin/embeddings/rebuild endpoint.
# Leave unset to disable the rebuild endpoint.
# ADMIN_TOKEN=change-me-in-production

# Set to True to skip model warmup on startup (useful for tests).
# DEBUG=False
